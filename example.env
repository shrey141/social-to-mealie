# --- Claude (Anthropic) setup ---
ANTHROPIC_API_KEY=sk-ant-... # set this to use Claude for recipe generation
TEXT_MODEL=claude-sonnet-4-5 # Claude model to use (e.g. claude-sonnet-4-5, claude-opus-4-6, claude-haiku-4-5)
LOCAL_TRANSCRIPTION_MODEL=Xenova/whisper-base # local Whisper model for transcription (no OpenAI needed)

# --- OpenAI-compatible setup (alternative to Claude) ---
# OPENAI_URL=https://api.openai.com/v1 # base URL for OpenAI-compatible provider
# OPENAI_API_KEY=sk-...
# TEXT_MODEL=gpt-4o
# TRANSCRIPTION_MODEL=whisper-1 # used when LOCAL_TRANSCRIPTION_MODEL is not set

# --- Mealie ---
MEALIE_URL=https://example.com # url of your mealie instance
MEALIE_API_KEY=ey...
MEALIE_GROUP_NAME=home # Optional, defaults to "home"

# --- Optional ---
# Optionally specify yt-dlp version to use. Use "latest" or a release tag like "2025.11.01".
# If provided, the container will try to download yt-dlp at startup
YTDLP_VERSION=latest
EXTRA_PROMPT= # extra instructions for the model (e.g. unit conversions, language)
COOKIES="NAME=VALUE" # cookies for yt-dlp requests, useful for protected content
